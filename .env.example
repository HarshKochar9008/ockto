# ---- Database: Tiger Data (Tiger Cloud) or the local TimescaleDB from compose.yaml.
# Tiger Cloud: copy the connection string from the console and append ?sslmode=require
DATABASE_URL=postgresql://postgres:papertrail@localhost:5440/papertrail

# ---- Temporal: local dev server from compose.yaml, or Temporal Cloud.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_UI_URL=http://localhost:8233
# Temporal Cloud: set TEMPORAL_API_KEY and TLS turns on automatically.
# TEMPORAL_API_KEY=

# ---- AI: any OpenAI-compatible endpoint. Defaults: Gemma on the local Ollama from compose.yaml.
AI_BASE_URL=http://localhost:11434/v1
AI_CHAT_MODEL=gemma3:4b
# AI_API_KEY=                      # hosted providers only
EMBEDDING_MODEL=embeddinggemma     # must return 768-dimensional vectors (see migrations/001_init.sql)
# EMBEDDING_BASE_URL=              # defaults to AI_BASE_URL
# EMBEDDING_API_KEY=               # defaults to AI_API_KEY
# OCR for PNG/JPEG uploads via a vision model. Empty = image uploads fail with "OCR not configured".
OCR_MODEL=gemma3:4b
AI_TIMEOUT_MS=600000

# ---- Sentry. Empty DSN = no error reporting and no trace export.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=dev
# Your org URL (e.g. https://my-org.sentry.io): turns stored event/trace ids into links on the activity page.
SENTRY_ORG_URL=
TRACE_RATE=1

# ---- File storage. local = ./data/uploads; s3 = any S3-compatible bucket (AWS, R2, MinIO, Tigris).
STORAGE_DRIVER=local
# STORAGE_DIR=data/uploads
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=                     # set for non-AWS providers
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=15

# ---- Reminders: Slack-compatible incoming webhook. Empty = reminders are shown in the app only.
REMINDER_WEBHOOK_URL=

# ---- Demo switch: lets the UI ask an activity to fail once, to show retries. Keep false in production.
DEMO_FAILURE_INJECTION=true

# ---- HTTP
PORT=3000
# NODE_ENV=production              # Secure cookies; also COOKIE_SECURE=true behind HTTPS
# TRUST_PROXY=true                 # behind a load balancer, so rate limits see client IPs
