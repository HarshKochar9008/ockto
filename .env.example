DATABASE_URL=postgresql://postgres:ockto@localhost:5440/postgres
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Temporal Cloud: set TEMPORAL_API_KEY and TLS turns on automatically.
# TEMPORAL_API_KEY=

# Empty = no tracing export, no error reporting.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=dev

# All traces are sampled by default. Once volume matters:
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
